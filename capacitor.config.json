{
  "appId": "com.notetrack.app",
  "appName": "NoteTrack",
  "webDir": "src",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#1e1e2e"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1e1e2e"
    }
  },
  "ios": {
    "contentInset": "always",
    "preferredContentMode": "mobile"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true
  }
}
