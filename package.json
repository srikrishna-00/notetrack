{
  "name": "appflowy-lean",
  "version": "0.1.0",
  "private": true,
  "description": "Ultra-lightweight, 100% feature-complete alternative to AppFlowy for desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/**/*.test.js",
    "smoke": "APPFLOWY_SMOKE=1 electron .",
    "web": "node scripts/serve.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "bash scripts/build-all-platforms.sh",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "build": {
    "appId": "io.appflowy.lean",
    "productName": "AppFlowy Lean",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  },
  "keywords": [
    "appflowy",
    "notion",
    "block-editor",
    "kanban",
    "database",
    "calendar",
    "local-first",
    "electron"
  ],
  "author": "srikrishna",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^44.7.2",
    "katex": "^0.19.0"
  }
}
