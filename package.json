{
  "name": "notetrack",
  "version": "1.0.0",
  "private": true,
  "description": "NoteTrack — Ultra-lean, private, all-in-one workspace for notes, docs, and databases",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/**/*.test.js",
    "smoke": "APPFLOWY_SMOKE=1 electron .",
    "web": "node scripts/serve.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "bash scripts/build-all-platforms.sh",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "build:android": "npx cap copy android"
  },
  "build": {
    "appId": "com.notetrack.app",
    "productName": "NoteTrack",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  },
  "keywords": [
    "appflowy",
    "notion",
    "block-editor",
    "kanban",
    "database",
    "calendar",
    "local-first",
    "electron"
  ],
  "author": "srikrishna",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "katex": "^0.19.1"
  }
}
